# ==============================================================
# DairyAI Nexus - Production Environment Configuration Template
# ==============================================================
# Copy this file to .env on your server or provide these values
# as environment variables in Docker / AWS ECS / Render.
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GIT!
# ==============================================================

# Server Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (MySQL / AWS RDS)
DB_URL=jdbc:mysql://your-rds-endpoint:3306/smart_dairy?useSSL=true&requireSSL=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# JWT Authentication
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_64_characters_long

# Redis Cache (AWS ElastiCache / Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring AI & Groq Inference Engine
GROQ_API_KEY=gsk_your_groq_api_key_here

# Twilio SMS Service (Farmer Alerts & OTP)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+16416718118

# Cloudinary Cloud Storage (Equipment & Bill Documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
